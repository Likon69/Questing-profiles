		<!-- Return to the caller. The caller sets BackToProfile before loading this snip; the
		     mechanism is HonorBuddy's own, taken from the Spegeli "Universal Navigation Snips". -->
		<CustomBehavior File="RunCode" Type="Definition"><![CDATA[
			private String CallerProfile { get { return ProfileManager.XmlLocation; } }

			async Task ReturnToCaller()
			{
				string profileName = (string)AppDomain.CurrentDomain.GetData("BackToProfile");
				if (string.IsNullOrEmpty(profileName))
				{ return; }

				if (!profileName.ToLower().EndsWith(".xml"))
				{ profileName += ".xml"; }

				string absolutePath = Path.GetFullPath(Path.Combine(Path.GetDirectoryName(CallerProfile), profileName));
				AppDomain.CurrentDomain.SetData("BackToProfile", null);

				TreeRoot.StatusText = "Loading profile '" + absolutePath + "'";
				ProfileManager.LoadNew(absolutePath);
			}
		]]></CustomBehavior>
		<CustomBehavior File="RunCode" Code="await ReturnToCaller();" />
