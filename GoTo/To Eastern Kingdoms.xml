<HBProfile>
	<Name>To Eastern Kingdoms</Name>
	<MinLevel>1</MinLevel>
	<MaxLevel>81</MaxLevel>
	<QuestOrder>
		<!-- Universal navigation snip, generated by qc_335/travel_335.py: transports from TaxiPathNode.dbc plus the transports table, portals from gameobject plus spell_target_position. -->
		<CustomBehavior File="UserSettings" LootMobs="False" />
		<If Condition="Me.MapId != 0">
			<If Condition="Me.IsAlliance">
				<If Condition="Me.MapId == 1">
					<!-- Kalimdor -> Menethil Harbor, 1 leg(s), ~4 min -->
					<RunTo X="-3999.067" Y="-4726.306" Z="4.3842" />
					<CustomBehavior File="UseTransport" TransportId="176231" DestName="The Lady Mehley" WaitAtX="-3999.067" WaitAtY="-4726.306" WaitAtZ="4.3842" TransportStartX="-4016.4" TransportStartY="-4740.6" TransportStartZ="0" StandOnX="-4006.659" StandOnY="-4734.664" StandOnZ="6.0765" TransportEndX="-3905.2" TransportEndY="-585.8" TransportEndZ="0" GetOffX="-3904.1" GetOffY="-605.2" GetOffZ="5.3" />
					<CustomBehavior File="WaitTimer" WaitTime="2000" />
				</If>
				<If Condition="Me.MapId == 530">
					<!-- Outland -> Stormwind Harbor, 1 leg(s), ~3 min -->
					<RunTo X="-1792.78" Y="5406.54" Z="-12.43" />
					<CustomBehavior File="GoThruPortal" X="-1792.78" Y="5406.54" Z="-12.43" Timeout="60000" />
					<CustomBehavior File="WaitTimer" WaitTime="5000" />
				</If>
				<If Condition="Me.MapId == 571">
					<!-- Northrend -> Stormwind Harbor, 1 leg(s), ~4 min -->
					<RunTo X="2234.375" Y="5132.568" Z="5.3432" />
					<CustomBehavior File="UseTransport" TransportId="190536" DestName="Stormwind's Pride" WaitAtX="2234.375" WaitAtY="5132.568" WaitAtZ="5.3432" TransportStartX="2218.4" TransportStartY="5119.6" TransportStartZ="0" StandOnX="2224.698" StandOnY="5120.346" StandOnZ="9.4524" TransportEndX="-8288.8" TransportEndY="1424.7" TransportEndZ="0" GetOffX="-8300.08" GetOffY="1405.158" GetOffZ="4.4224" />
					<CustomBehavior File="WaitTimer" WaitTime="2000" />
				</If>
			</If>
			<If Condition="Me.IsHorde">
				<If Condition="Me.MapId == 1">
					<!-- Kalimdor -> Undercity zeppelin tower, 1 leg(s), ~2 min -->
					<RunTo X="1912.07" Y="-4151.78" Z="40.64" />
					<CustomBehavior File="GoThruPortal" X="1912.07" Y="-4151.78" Z="40.64" Timeout="60000" />
					<CustomBehavior File="WaitTimer" WaitTime="5000" />
				</If>
				<If Condition="Me.MapId == 530">
					<!-- Outland -> Undercity zeppelin tower, 1 leg(s), ~2 min -->
					<RunTo X="-1931.48" Y="5460.49" Z="-12.43" />
					<CustomBehavior File="GoThruPortal" X="-1931.48" Y="5460.49" Z="-12.43" Timeout="60000" />
					<CustomBehavior File="WaitTimer" WaitTime="5000" />
				</If>
				<If Condition="Me.MapId == 571">
					<!-- Northrend -> Undercity zeppelin tower, 1 leg(s), ~4 min -->
					<RunTo X="1975.661" Y="-6097.837" Z="67.1533" />
					<CustomBehavior File="UseTransport" TransportId="181689" DestName="The Cloudkisser" WaitAtX="1975.661" WaitAtY="-6097.837" WaitAtZ="67.1533" TransportStartX="1989.4" TransportStartY="-6082.8" TransportStartZ="85.6" StandOnX="1981.89" StandOnY="-6090.596" StandOnZ="67.7387" TransportEndX="2056.5" TransportEndY="381.6" TransportEndZ="100.4" GetOffX="2060.931" GetOffY="361.9963" GetOffZ="82.5015" />
					<CustomBehavior File="WaitTimer" WaitTime="2000" />
				</If>
			</If>
		</If>
		<!-- Return to the caller. The caller sets BackToProfile before loading this snip; the
		     mechanism is HonorBuddy's own, taken from the Spegeli "Universal Navigation Snips". -->
		<CustomBehavior File="RunCode" Type="Definition"><![CDATA[
			private String CallerProfile { get { return ProfileManager.XmlLocation; } }

			async Task ReturnToCaller()
			{
				string profileName = (string)AppDomain.CurrentDomain.GetData("BackToProfile");
				if (string.IsNullOrEmpty(profileName))
				{ return; }

				if (!profileName.ToLower().EndsWith(".xml"))
				{ profileName += ".xml"; }

				string absolutePath = Path.GetFullPath(Path.Combine(Path.GetDirectoryName(CallerProfile), profileName));
				AppDomain.CurrentDomain.SetData("BackToProfile", null);

				TreeRoot.StatusText = "Loading profile '" + absolutePath + "'";
				ProfileManager.LoadNew(absolutePath);
			}
		]]></CustomBehavior>
		<CustomBehavior File="RunCode" Code="await ReturnToCaller();" />
	</QuestOrder>
</HBProfile>
